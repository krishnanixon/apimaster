{
  "name": "shurikly",
  "version": "1.0.0",
  "description": "Shurikly — the open-source, local-first API client with built-in AI",
  "keywords": [
    "api-client",
    "rest",
    "graphql",
    "websocket",
    "postman-alternative",
    "mock-server",
    "mcp",
    "electron",
    "local-first",
    "ai"
  ],
  "homepage": "https://github.com/shurikly/shurikly#readme",
  "bugs": {
    "url": "https://github.com/shurikly/shurikly/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shurikly/shurikly.git"
  },
  "main": "./out/main/index.js",
  "author": "Wansify Ventures",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --config.electronDist=node_modules/electron/dist",
    "dist:linux": "npm run build && electron-builder --linux",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64 --arm64"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.5",
    "@fontsource/inter": "^5.2.8",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@uiw/codemirror-themes": "^4.25.10",
    "@uiw/react-codemirror": "^4.25.10",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cm6-graphql": "^0.2.2",
    "electron-updater": "^6.8.9",
    "form-data": "^4.0.6",
    "framer-motion": "^12.42.2",
    "graphql": "^16.11.0",
    "graphql-language-service": "^5.7.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "ignore": "^5.3.2",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.525.0",
    "openai": "^5.8.2",
    "quickjs-emscripten-core": "0.32.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.1",
    "react-router-dom": "^7.6.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tough-cookie": "^6.0.2",
    "typescript": "^5.9.3",
    "uuid": "^11.1.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "electron": "^41.10.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "happy-dom": "^20.14.5",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "tailwindcss": "^3.4.17",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "build": {
    "extends": "./build/mac-signing.cjs",
    "appId": "com.shurikly.app",
    "productName": "Shurikly",
    "copyright": "Copyright © 2026 Wansify Ventures",
    "npmRebuild": false,
    "icon": "build/icon.png",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "public/shurikly.png",
        "to": "resources/shurikly.png"
      },
      {
        "from": "public/app-icon.png",
        "to": "resources/app-icon.png"
      },
      {
        "from": "out/main/mcp-stdio.js",
        "to": "mcp-stdio.js"
      }
    ],
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "node_modules/quickjs-emscripten-core/**",
      "node_modules/@jitl/quickjs-ffi-types/**",
      "node_modules/@jitl/quickjs-wasmfile-release-sync/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "build/license.txt",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shurikly"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "shurikly",
      "repo": "shurikly",
      "releaseType": "draft"
    }
  }
}
