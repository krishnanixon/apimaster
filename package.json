{
  "name": "ai-requirement-studio",
  "version": "1.0.0",
  "description": "Tessarok - All-in-one AI-powered desktop workspace for software engineers and development teams",
  "main": "./out/main/index.js",
  "author": "Tessarok",
  "license": "MIT",
  "scripts": {
    "dev": "npm run db:generate && electron-vite dev",
    "build": "npm run db:generate && electron-vite build && node scripts/copy-kokoro-voices.mjs",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/postinstall.mjs",
    "rebuild:native": "node scripts/postinstall.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --config.electronDist=node_modules/electron/dist",
    "dist:linux": "npm run build && electron-builder --linux",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64 --arm64"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.9.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.5",
    "@cursorless/tree-sitter-wasms": "^0.10.0",
    "@fontsource/inter": "^5.2.8",
    "@lezer/highlight": "^1.2.3",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@replit/codemirror-minimap": "^0.5.2",
    "@tiptap/extension-code-block-lowlight": "^2.22.3",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-highlight": "^2.22.3",
    "@tiptap/extension-image": "^2.22.3",
    "@tiptap/extension-link": "^2.22.3",
    "@tiptap/extension-placeholder": "^2.22.3",
    "@tiptap/extension-subscript": "^2.27.2",
    "@tiptap/extension-superscript": "^2.27.2",
    "@tiptap/extension-table": "^2.22.3",
    "@tiptap/extension-table-cell": "^2.22.3",
    "@tiptap/extension-table-header": "^2.22.3",
    "@tiptap/extension-table-row": "^2.22.3",
    "@tiptap/extension-task-item": "^2.22.3",
    "@tiptap/extension-task-list": "^2.22.3",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.22.3",
    "@tiptap/react": "^2.22.3",
    "@tiptap/starter-kit": "^2.22.3",
    "@uiw/codemirror-themes": "^4.25.10",
    "@uiw/react-codemirror": "^4.25.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.1",
    "axios": "^1.20.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "date-fns": "^4.1.0",
    "docx": "^9.5.0",
    "dotenv": "^16.6.1",
    "ffmpeg-static": "^5.3.0",
    "form-data": "^4.0.6",
    "framer-motion": "^12.42.2",
    "html-to-image": "^1.11.13",
    "koffi": "^3.1.0",
    "kokoro-js": "^1.2.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.525.0",
    "mongodb": "^6.21.0",
    "mssql": "^12.7.0",
    "mysql2": "^3.22.5",
    "node-pty": "^1.1.0",
    "nodejs-whisper": "^0.3.1",
    "onnxruntime-node": "1.21.0",
    "openai": "^5.8.2",
    "pg": "^8.22.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.1",
    "react-router-dom": "^7.6.3",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "sql-formatter": "^15.8.2",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.3.1",
    "typescript": "^5.8.3",
    "unpdf": "^1.8.1",
    "uuid": "^11.1.0",
    "web-tree-sitter": "^0.26.12",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ssh2": "^1.15.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "electron": "^41.10.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "prisma": "^7.10.0",
    "tailwindcss": "^3.4.17",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "build": {
    "appId": "com.airequirementstudio.app",
    "productName": "Tessarok",
    "npmRebuild": false,
    "icon": "public/tess.png",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "public/tess.png",
        "to": "resources/tess.png"
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/node-pty/**",
      "**/node_modules/node-pty/build/**",
      "**/node_modules/@node-rs/argon2/**",
      "**/node_modules/@node-rs/argon2-*/**",
      "**/node_modules/ssh2/**",
      "**/node_modules/pg/**",
      "**/node_modules/mysql2/**",
      "**/node_modules/mssql/**",
      "**/node_modules/web-tree-sitter/**",
      "**/node_modules/@cursorless/tree-sitter-wasms/**",
      "**/node_modules/typescript/**",
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/nodejs-whisper/**",
      "**/node_modules/onnxruntime-node/**"
    ],
    "files": [
      "out/**/*",
      "generated/prisma/**/*",
      "node_modules/@prisma/adapter-better-sqlite3/**/*",
      "node_modules/@prisma/client/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/web-tree-sitter/**/*",
      "node_modules/@cursorless/tree-sitter-wasms/**/*",
      "node_modules/typescript/**/*",
      "node_modules/nodejs-whisper/**/*",
      "node_modules/kokoro-js/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/@huggingface/transformers/**/*",
      "node_modules/ffmpeg-static/**/*",
      "prisma/schema.prisma"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "build/license.txt",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tessarok"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "public/tess.png",
      "identity": null
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
